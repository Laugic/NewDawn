using Microsoft.Xna.Framework;
using NewDawn.Abstracts;
using NewDawn.Items.Materials;
using NewDawn.Tiles;
using System;
using Terraria;
using Terraria.ID;
using Terraria.Localization;
using Terraria.ModLoader;

namespace NewDawn.Items.Alchemistry.Essences
{
    public class ChaosInfusion : ModItem
    {
        public override void SetStaticDefaults()
        {
            Tooltip.SetDefault("+40 max mana\nEnemies are more likely to spawn and target you\n20% chance not to consume ammo");
        }

        public override void SetDefaults()
        {
            Item.width = 32;
            Item.height = 32;
            Item.value = Item.sellPrice(silver: 50);
            Item.rare = ItemRarityID.Orange;
            Item.maxStack = 1;
            Item.accessory = true;
            Item.canBePlacedInVanityRegardlessOfConditions = true;
        }

        public override void UpdateEquip(Player player)
        {
            player.statManaMax2 += 40;
            player.enemySpawns = true;
            player.aggro += 5;
            player.ammoCost80 = true;
        }

        public override void AddRecipes()
        {
            Recipe recipe = CreateRecipe();
            recipe.AddIngredient(ModContent.ItemType<ChaosEssence>(), 3);
            recipe.AddCondition(InfusionCrystal.Infusion);
            recipe.Register();
        }
    }
}
